    { "input": "", "output": "" }
  ],
  "webAddress": [
    { "name": "plain http kept", "input": " HTTP://Example.com/rss ", "output": "http://example.com/rss" },
    { "name": "https with a path added", "input": "https://example.com", "output": "https://example.com/" },
    { "name": "http's own port left out", "input": "http://example.com:80/rss", "output": "http://example.com/rss" },
    { "name": "https's port kept on http", "input": "http://example.com:443/rss", "output": "http://example.com:443/rss" },
    { "name": "https's own port left out", "input": "https://example.com:443/rss", "output": "https://example.com/rss" },
    { "name": "http's port kept on https", "input": "https://example.com:80/rss", "output": "https://example.com:80/rss" },
    { "name": "scheme and host in lower case, path kept", "input": "HTTPS://EXAMPLE.COM/Feed", "output": "https://example.com/Feed" },
    { "name": "trailing dot kept", "input": "http://example.com./rss", "output": "http://example.com./rss" },
    { "name": "fragment kept", "input": "http://example.com/rss#top", "output": "http://example.com/rss#top" },
    { "name": "international name", "input": "http://bücher.example/rss", "output": "http://xn--bcher-kva.example/rss" },
    { "name": "space escaped", "input": "http://example.com/a b", "output": "http://example.com/a%20b" },
    { "name": "user and password refused", "input": "http://user:secret@example.com/rss", "output": "" },
    { "name": "user refused", "input": "https://user@example.com/rss", "output": "" },
    { "name": "another scheme", "input": "ftp://example.com/rss", "output": "" },
    { "name": "empty", "input": "", "output": "" }
  ],
