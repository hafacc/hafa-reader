<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing goes to Google's cloud backup (allowBackup is false, which on Android 12 and later
    turns off only that); moving to a new phone by cable or Wi-Fi still brings the reader along.
-->
<data-extraction-rules>
    <device-transfer>
        <include domain="database" path="reader.db" />
        <include domain="database" path="reader.db-wal" />
        <include domain="database" path="reader.db-shm" />
        <include domain="sharedpref" path="reader.xml" />
        <!-- the account the data came from, so a different account on the new phone must choose first -->
        <include domain="sharedpref" path="sync.xml" />
    </device-transfer>
</data-extraction-rules>
